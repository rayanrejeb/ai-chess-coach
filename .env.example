# Copy to .env and fill in. Values here are fake.
# Environment variables override the values saved from the Settings window.

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Lichess personal token (optional, sent with Lichess sync requests when set): https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Full path to the Stockfish binary: https://stockfishchess.org/download/
# On Windows, e.g. C:\stockfish\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=/usr/local/bin/stockfish

# Username pre-filled on first launch
DEFAULT_USERNAME=your-username

# Usernames for the sync command (python -m ai_chess_coach.sync), if they differ from DEFAULT_USERNAME
CHESSCOM_USERNAME=
LICHESS_USERNAME=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
