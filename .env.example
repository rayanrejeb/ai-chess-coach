# Copy to .env and fill in. Values here are fake.
# Environment variables override the values saved from the Settings window.

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Lichess personal token (only needed to sync Lichess games): https://lichess.org/account/oauth/token
LICHESS_TOKEN=lip_your-lichess-token

# Full path to the Stockfish binary: https://stockfishchess.org/download/
STOCKFISH_PATH=/usr/local/bin/stockfish

# Username pre-filled on first launch
DEFAULT_USERNAME=your-username

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
